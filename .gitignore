# --- 1. IGNORE EVERYTHING BY DEFAULT ---
*

# --- 2. ALLOW FOLDERS (Re-include directories) ---
!*/
!hybridstack/**
!scripts/**
!data/BioGrid/
!data/BioGrid/Human/
!data/BioGrid/Yeast/
!data/annotations/
!data/negatome/
!data/elm_motifs_freeze.tsv
!models/**
!notebooks/**
!utils/**

# --- 3. ALLOW SPECIFIC ROOT FILES ---
!requirements.txt
!README.md
!.gitignore
!LICENSE
!reproduce_results.py
!reviewer2_deep_analysis.md
!HybridStackPPI_Final_Report.md
!figures/**
!archive/**

# --- 4. EXPLICITLY IGNORE JUNK INSIDE ALLOWED FOLDERS ---
# Even inside allowed folders, we don't want these:
__pycache__/
*.pyc
*.pyo
.DS_Store
.venv/
venv/
.env
*.log
*.zip
*.tar.gz
*.tmp
*.bak
*~

# --- 5. BLOCK LARGE FILES ---
# Prevent pushing large files > 100MB
*.pth
*.pt
*.bin
*.h5
*.pkl
*.joblib

# --- 6. IGNORE EXTERNAL/GENERATED CONTENT ---
external/
external_tools/
external_tools_backup_*/
# Allow specific paths in cache and results
!cache/
!results/

logs/
reports/
benchmarks/
*.lock
.agent
tmp*
nohup.out
*_pid.txt
LOG_*.txt
*.pdf
*.png

# --- 7. WHITELIST CORE ASSETS FOR REPLICATION ---
# Ignore all by default in these folders
cache/*
results/*

# Re-include mapping and dictionary files (Exclude .h5 from GitHub as they exceed 2GB)
!cache/*_cluster_map.csv
!cache/human_dict_cdhit_40*
!cache/yeast_dict_cdhit_40*

# Re-include trained models for Same-GO
!results/human_same_go/
!results/human_same_go/*
!results/human_same_go/models/
!results/human_same_go/models/*.joblib
!results/yeast_same_go/
!results/yeast_same_go/*
!results/yeast_same_go/models/
!results/yeast_same_go/models/*.joblib

# --- 7. IGNORE NON-CORE/DERIVED DATASETS ---
data/BioGrid/Human/CDHIT_Reduced/
data/BioGrid/Yeast/CDHIT_Reduced/
data/LPBERT/
data/deeptrio/
data/seq_ppi/
data/xCAPT5/
data/rapppid/
data/pids/

HybridStackPPI_Final_Report.md
archive/
figures/
reviewer2_deep_analysis.md
IEEE_Access/
BioGrid/Human/human_pairs_diff_compartment.tsv
BioGrid/Yeast/yeast_pairs_diff_compartment.tsv
